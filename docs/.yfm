allowHtml: true

analytics:
  metrika:
    - id: 111923254

langs: ['ru', 'en']

docs-viewer:
  langs: ['en','ru']
  logo-options:
    src: /ru/_files/logo.png
  controls-position: top

themes: ['light', 'dark']

interface:
  favicon-src: /ru/_files/favicon.ico

search:
  provider: local

allowCustomResources: true

resources:
  style:
    - _assets/style/custom.css
  script:
    - _assets/scripts/custom.js

pdf:
  enabled: true